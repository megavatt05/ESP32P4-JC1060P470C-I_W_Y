# ESP-IDF 5.5.x — JC1060P470C camera-photo-app
# Chip: ESP32-P4 revision v1.3 (eco2). Rev <3.0 and >=3.0 are mutually exclusive.
#
CONFIG_IDF_TARGET="esp32p4"

# === Chip revision: MUST be LESS_V3 for silicon v1.x (your board is v1.3) ===
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y
# Do NOT set REV_MIN_300 / REV_MIN_301 — those target v3.x only

CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# JC1060P470C + OV02C10 SCCB
CONFIG_EXAMPLE_MIPI_CSI_SCCB_I2C_SCL_PIN=8
CONFIG_EXAMPLE_MIPI_CSI_SCCB_I2C_SDA_PIN=7
CONFIG_BOARD_TYPE_JC1060P470=y

# PSRAM
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y

CONFIG_FREERTOS_HZ=1000
CONFIG_LWIP_HOOK_IP6_INPUT_NONE=y

# Camera OV02C10 — 1288x728 reduces ISP load (1080p often causes fifo overflow on v1.3)
CONFIG_CAMERA_OV02C10=y
CONFIG_CAMERA_OV02C10_AUTO_DETECT=y
CONFIG_CAMERA_OV02C10_AUTO_DETECT_MIPI_INTERFACE_SENSOR=y
CONFIG_CAMERA_OV02C10_MIPI_RAW10_1288x728_30FPS=y
# CONFIG_CAMERA_OV02C10_MIPI_RAW10_1920x1080_30FPS is not set
# CONFIG_CAMERA_OV02C10_ISP_AF_ENABLE is not set

CONFIG_ESP_VIDEO_ENABLE_ISP_PIPELINE_CONTROLLER=y
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_PM_ENABLE=y

CONFIG_PARTITION_TABLE_OFFSET=0x9000
